---
import Arrow from "../components/common/Arrow.astro";
import PageHeading from "../components/PageHeading.astro";
import Prose from "../components/Prose.astro";
import type { ProjectFrontmatter } from "../lib/types";
import { getConfigurationCollection } from "../lib/utils";
import Layout from "./Layout.astro";

type Props = { frontmatter: ProjectFrontmatter };

const { frontmatter } = Astro.props;
const { data: config } = await getConfigurationCollection();
---

<Layout>
  <Fragment slot="head">
    <title>{`${frontmatter.title} • ${config.personal.name}`}</title>
    <meta
      name="description"
      content={frontmatter.longDescription ?? frontmatter.description}
    />
    <meta
      property="og:title"
      content={`${frontmatter.title} • ${config.personal.name}`}
    />
    <meta property="og:description" content={frontmatter.description} />
    {
      frontmatter.tags && (
        <meta name="keywords" content={frontmatter.tags.join(", ")} />
      )
    }
    {
      frontmatter.cardImage && (
        <meta property="og:image" content={frontmatter.cardImage} />
      )
    }
    <meta
      property="og:url"
      content={`${config.site.baseUrl}/projects/${frontmatter.slug}`}
    />
    <meta name="twitter:card" content="summary" />
    <meta
      name="twitter:title"
      content={`${frontmatter.title} • ${config.personal.name}`}
    />
    <meta name="twitter:description" content={frontmatter.description} />
    {
      frontmatter.cardImage && (
        <meta name="twitter:image" content={frontmatter.cardImage} />
      )
    }
    <meta http-equiv="content-language" content="en" />
    <meta name="language" content="English" />
    <link
      rel="canonical"
      href={`${config.site.baseUrl}/projects/${frontmatter.slug}`}
    />
  </Fragment>
  <PageHeading title={frontmatter.title} eyebrow={frontmatter.language}>
    <p class="mt-5 max-w-lg text-[17px] leading-[1.72] text-(--body) italic">
      {frontmatter.description}
    </p>
    <div class="caps mt-8 flex flex-wrap justify-center gap-6 text-(--body)">
      {
        frontmatter.githubUrl && (
          <a class="lnk inline-flex items-center gap-1.5" href={frontmatter.githubUrl}>
            GitHub
            <Arrow />
          </a>
        )
      }
      {
        frontmatter.liveDemoUrl && (
          <a class="lnk inline-flex items-center gap-1.5" href={frontmatter.liveDemoUrl}>
            Website
            <Arrow />
          </a>
        )
      }
    </div>
    {
      frontmatter.tags && frontmatter.tags.length > 0 && (
        <ul class="mt-8 flex flex-wrap justify-center gap-2">
          {frontmatter.tags.map((tag) => (
            <li class="chip">{tag}</li>
          ))}
        </ul>
      )
    }
  </PageHeading>
  <Prose>
    <slot />
  </Prose>
</Layout>
