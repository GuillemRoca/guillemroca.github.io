---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#141d29" />
    <!-- Professional (navy) or Personal (ivory): from ?mode=, else the last choice. Runs before paint. -->
    <script is:inline>
      (function () {
        var mode = new URLSearchParams(location.search).get("mode");
        try {
          if (mode === "personal" || mode === "professional") {
            localStorage.setItem("mode", mode);
          } else {
            mode = localStorage.getItem("mode");
          }
        } catch (e) {}
        if (mode !== "personal") mode = "professional";
        document.documentElement.dataset.mode = mode;
        if (mode === "personal") {
          document
            .querySelector('meta[name="theme-color"]')
            .setAttribute("content", "#faf7f0");
        }
      })();
    </script>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <div class="page flex min-h-screen flex-col pt-3 pb-[88px] md:pt-11 md:pb-28">
      <Header />
      <main class="flex flex-col">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
