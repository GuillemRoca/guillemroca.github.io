---
import SocialLinks from './SocialLinks.astro';
---

<section class="hero">
    <div class="hero-content">
        <div class="hero-text">
            <h1>Hi, I'm <span class="highlight">Guillem</span></h1>
            <h2 class="role">Software Engineer - Android</h2>
            <p class="bio">
                I re-envision how people interact with media technologies. Currently building at <a href="https://play.google.com/store/apps/details?id=com.wallapop" target="_blank" class="company-link">Wallapop</a>. <span class="highlight-science">Expert in Kotlin, Android SDK, and Jetpack Compose</span>.
            </p>
            <div class="social-wrapper">
                <SocialLinks />
            </div>
        </div>
        <div class="hero-image">
            <img src="https://github.com/GuillemRoca.png" alt="Guillem Roca" />
        </div>
    </div>
</section>

<style>
    .hero {
        padding: 5rem 0;
        display: flex;
        align-items: center;
    }

    .hero-content {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 3rem;
        align-items: center;
        width: 100%;
    }

    h1 {
        font-size: 3rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        line-height: 1.1;
        letter-spacing: -0.02em;
    }

    .highlight {
        color: var(--accent-primary);
    }

    .role {
        font-size: 1.4rem;
        font-weight: 500;
        margin-bottom: 1.5rem;
        opacity: 0.7;
    }

    .bio {
        font-size: 1.1rem;
        line-height: 1.7;
        margin-bottom: 2rem;
        opacity: 0.9;
        max-width: 500px;
    }
    
    .company-link {
        color: var(--text-color);
        font-weight: 600;
        border-bottom: 2px solid var(--accent-secondary);
        text-decoration: none;
        transition: color 0.2s;
    }

    .company-link:hover {
        color: var(--accent-secondary);
    }

    .highlight-science {
        color: var(--accent-primary);
        font-weight: 600;
    }
    
    .social-wrapper {
        margin-top: 1rem;
    }

    .hero-image {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .hero-image img {
        width: 280px;
        height: 280px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid var(--surface-color);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    }

    @media (max-width: 768px) {
        .hero {
            padding: 3rem 0;
        }

        .hero-content {
            grid-template-columns: 1fr;
            text-align: center;
            gap: 2rem;
        }

        .hero-content {
            display: flex;
            flex-direction: column-reverse;
        }

        .bio {
            margin: 0 auto 2rem auto;
        }
        
        .social-wrapper {
            display: flex;
            justify-content: center;
        }
        
        .hero-image img {
            width: 200px;
            height: 200px;
        }
    }
</style>
