---
import { getConfigurationCollection } from "../../lib/utils";
import Arrow from "../common/Arrow.astro";

type Props = { showToggle?: boolean };

const { showToggle = true } = Astro.props;
const { data: config } = await getConfigurationCollection();
const { hero, personal } = config;

const ornament = `<svg class="mode-ornament" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-dasharray="2 3"/><circle cx="12" cy="12" r="3.5"/><circle cx="12" cy="12" r="1" fill="currentColor"/></svg>`;
---

<section id="top" class="flex flex-col items-center pt-9 text-center md:pt-[72px]">
  {
    showToggle && (
      <div class="mode-row">
        <Fragment set:html={ornament} />
        <fieldset class="mode-toggle">
          <legend class="sr-only">View</legend>
          <span class="mode-indicator" aria-hidden="true" />
          <button type="button" data-mode="professional" aria-pressed="true">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="3" />
              <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" />
            </svg>
            Professional
          </button>
          <button type="button" data-mode="personal" aria-pressed="false">
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M12 1.5c.6 5.8 2.4 7.8 10.5 10.5-8.1 2.7-9.9 4.7-10.5 10.5-.6-5.8-2.4-7.8-10.5-10.5C9.6 9.3 11.4 7.3 12 1.5z" />
            </svg>
            Personal
          </button>
        </fieldset>
        <Fragment set:html={ornament} />
      </div>
    )
  }

  <button
    type="button"
    class="portrait mt-10 md:mt-12"
    data-flip
    aria-label="Flip portrait: switch to the personal view"
    disabled={!showToggle}
  >
    <svg class="portrait-rings" viewBox="0 0 200 200" aria-hidden="true">
      <g class="whirl">
        <circle cx="100" cy="100" r="95" fill="none" stroke="currentColor" stroke-width="1" opacity="0.35"></circle>
        <path d="M100 5a95 95 0 0 1 95 95" fill="none" stroke="currentColor" stroke-width="1.8" opacity="0.7"></path>
        <path d="M195 100a95 95 0 0 1-95 95" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.45"></path>
      </g>
      <g class="whirl whirl--medium">
        <circle cx="100" cy="100" r="89" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.3"></circle>
        <path d="M100 11a89 89 0 0 1 89 89" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.55"></path>
        <path d="M11 100a89 89 0 0 1 89-89" fill="none" stroke="currentColor" stroke-width="0.9" opacity="0.4"></path>
      </g>
      <g class="whirl whirl--fast">
        <path d="M100 18a82 82 0 0 1 50 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" opacity="0.6"></path>
        <path d="M182 100a82 82 0 0 1-12 50" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" opacity="0.6"></path>
        <path d="M100 182a82 82 0 0 1-50-12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" opacity="0.6"></path>
        <path d="M18 100a82 82 0 0 1 12-50" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" opacity="0.6"></path>
      </g>
    </svg>
    <span class="portrait-inner">
      <span class="portrait-face portrait-front">
        <img
          src={hero.image}
          alt={hero.imageAlt}
          width="480"
          height="480"
          fetchpriority="high"
        />
      </span>
      {
        hero.personalImage && (
          <span class="portrait-face portrait-back">
            <img
              src={hero.personalImage}
              alt={hero.personalImageAlt}
              width="480"
              height="480"
              loading="lazy"
            />
          </span>
        )
      }
    </span>
  </button>

  <h1
    class="mt-8 font-display text-[46px] leading-none font-medium tracking-[-0.015em] text-(--ink) md:mt-10 md:text-[60px]"
  >
    <span data-show="professional">{personal.name}</span>
    <span data-show="personal">{hero.shortName ?? personal.name}</span>
  </h1>

  <div data-show="professional" class="flex flex-col items-center">
    <p class="caps mt-[18px] tracking-[0.2em] text-(--muted)">
      {hero.role}
      {
        hero.specialty && (
          <>
            <span class="px-2 text-(--sep)">&#8212;</span>
            {hero.specialty}
          </>
        )
      }
      {
        hero.location && (
          <>
            <span class="px-2 text-(--sep)">&#183;</span>
            {hero.location}
          </>
        )
      }
    </p>
    {
      hero.company && (
        <p class="mt-5 text-[17px] text-(--body) italic">
          Currently building at{" "}
          <a class="lnk inline-link" href={hero.companyUrl}>
            {hero.company}
            <Arrow class="ml-1 inline align-baseline" />
          </a>
        </p>
      )
    }
  </div>
  {
    hero.personalTagline && (
      <p data-show="personal" class="mt-5 text-[17px] text-(--body) italic">
        {hero.personalTagline}
      </p>
    )
  }
</section>

<script>
  type Mode = "professional" | "personal";

  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>(".mode-toggle button[data-mode]");
  const flip = document.querySelector<HTMLButtonElement>("[data-flip]");
  const themeColor = document.querySelector<HTMLMetaElement>(
    'meta[name="theme-color"]',
  );

  const currentMode = (): Mode =>
    root.dataset.mode === "personal" ? "personal" : "professional";

  function syncControls(mode: Mode) {
    for (const button of buttons) {
      button.setAttribute("aria-pressed", String(button.dataset.mode === mode));
    }
    flip?.setAttribute(
      "aria-label",
      `Flip portrait: switch to the ${mode === "professional" ? "personal" : "professional"} view`,
    );
  }

  let fadeTimer: number | undefined;

  function setMode(mode: Mode) {
    if (mode === currentMode()) return;
    root.classList.add("mode-anim");
    window.clearTimeout(fadeTimer);
    fadeTimer = window.setTimeout(() => root.classList.remove("mode-anim"), 600);

    root.dataset.mode = mode;
    try {
      localStorage.setItem("mode", mode);
    } catch {}
    themeColor?.setAttribute("content", mode === "personal" ? "#faf7f0" : "#141d29");
    syncControls(mode);

    const url = new URL(window.location.href);
    url.searchParams.set("mode", mode);
    history.replaceState(null, "", url);
  }

  for (const button of buttons) {
    button.addEventListener("click", () =>
      setMode(button.dataset.mode === "personal" ? "personal" : "professional"),
    );
  }
  flip?.addEventListener("click", () =>
    setMode(currentMode() === "personal" ? "professional" : "personal"),
  );

  syncControls(currentMode());
</script>
