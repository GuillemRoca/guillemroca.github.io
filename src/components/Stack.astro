---
type Props = { skills: string[] };

const { skills } = Astro.props;
---

<ul class="grid grid-cols-2 gap-x-6 border-b border-(--line) md:grid-cols-3">
  {
    skills.map((skill, index) => (
      <li class="flex items-baseline gap-3 border-t border-(--line) py-3 text-base whitespace-nowrap text-(--ink-2)">
        <span class="text-[11px] tracking-[0.08em] text-(--index) tabular-nums">
          {String(index + 1).padStart(2, "0")}
        </span>
        {skill}
      </li>
    ))
  }
</ul>
