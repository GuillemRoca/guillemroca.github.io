---
import { getConfigurationCollection } from "../lib/utils";

const { data: config } = await getConfigurationCollection();
const year = new Date().getFullYear();
---

<footer class="mt-auto flex flex-col items-center gap-4 pt-20 text-center md:gap-5 md:pt-[104px]">
  <svg width="40" height="12" viewBox="0 0 40 12" aria-hidden="true">
    <line x1="0" y1="6" x2="14" y2="6" stroke="var(--line-2)" stroke-width="1"
    ></line>
    <circle cx="20" cy="6" r="2.2" fill="var(--accent)"></circle>
    <line x1="26" y1="6" x2="40" y2="6" stroke="var(--line-2)" stroke-width="1"
    ></line>
  </svg>
  <p class="font-display text-lg text-(--body) italic">
    Made in {config.hero.location ?? "Barcelona"}.
  </p>
  <p class="caps tracking-[0.14em] text-(--muted) tabular-nums">
    &#169; {year} {config.personal.name}
  </p>
</footer>
