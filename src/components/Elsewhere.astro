---
import { getConfigurationCollection } from "../lib/utils";
import Arrow from "./common/Arrow.astro";

type LinkKey = "github" | "x" | "linkedin" | "bluesky" | "email";

type Props = {
  include?: LinkKey[];
  emailLabel?: string;
};

const {
  include = ["github", "x", "linkedin", "bluesky", "email"],
  emailLabel = "Email",
} = Astro.props;
const { data: config } = await getConfigurationCollection();
const { personal } = config;

const handleFrom = (url: string | undefined, prefix: string) =>
  url ? url.replace(/\/$/, "").split("/").pop()?.replace(/^/, prefix) : "";

const all: Record<
  LinkKey,
  { label: string; handle?: string; url?: string; icon: string }
> = {
  github: {
    label: "GitHub",
    handle: handleFrom(personal.githubProfile, ""),
    url: personal.githubProfile,
    icon: '<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>',
  },
  x: {
    label: "X",
    handle: handleFrom(personal.twitterProfile, "@"),
    url: personal.twitterProfile,
    icon: '<path d="M4 4l11.7 16H20L8.3 4H4z"/><path d="M4 20l6.8-6.8M20 4l-6.8 6.8"/>',
  },
  linkedin: {
    label: "LinkedIn",
    handle: handleFrom(personal.linkedinProfile, "in/"),
    url: personal.linkedinProfile,
    icon: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M7.5 10.5V17M7.5 7.3v.01M11.5 17v-6.5M11.5 13.6c0-1.9 1.1-3.1 2.8-3.1 1.6 0 2.7 1.1 2.7 3.1V17"/>',
  },
  bluesky: {
    label: "Bluesky",
    handle: handleFrom(personal.blueskyProfile, "@"),
    url: personal.blueskyProfile,
    icon: '<path d="M12 11.2C10.8 8.9 7.6 4.6 4.7 3.2 3.4 2.6 2.2 2.9 2.2 5c0 .9.5 5.1.8 6 .9 3 4 3.7 6.8 3.2-4.2.7-5.3 3-3 5.4 4.3 4.4 6.2-1.1 6.7-2.5l.5-1.4.5 1.4c.5 1.4 2.4 6.9 6.7 2.5 2.3-2.4 1.2-4.7-3-5.4 2.8.5 5.9-.2 6.8-3.2.3-.9.8-5.1.8-6 0-2.1-1.2-2.4-2.5-1.8-2.9 1.4-6.1 5.7-7.3 8z"/>',
  },
  email: {
    label: emailLabel,
    handle: personal.contactEmail,
    url: personal.contactEmail ? `mailto:${personal.contactEmail}` : undefined,
    icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5l8.5 6 8.5-6"/>',
  },
};

const links = include.map((key) => all[key]).filter((link) => link.url);
---

<ul class="rule-list">
  {
    links.map((link) => (
      <li class="rule-item">
        <a
          class="lnk grid h-[54px] grid-cols-[20px_minmax(0,1fr)_auto_14px] items-center gap-x-4"
          href={link.url}
          rel={link.url?.startsWith("http") ? "me noopener" : undefined}
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={link.icon}
          />
          <span class="text-base">{link.label}</span>
          <span class="truncate text-sm text-(--muted)">{link.handle}</span>
          <Arrow />
        </a>
      </li>
    ))
  }
</ul>
