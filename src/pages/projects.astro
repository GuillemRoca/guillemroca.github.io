---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = [
	{
		title: "samples-jetpack-compose",
		description:
			"A comprehensive collection of Jetpack Compose sample projects demonstrating best practices, UI components, and advanced features.",
		tags: ["Kotlin", "Compose", "Android"],
		url: "https://github.com/GuillemRoca/samples-jetpack-compose",
	},
	{
		title: "birds",
		description:
			"A wholesome birds display application built using Kotlin Multiplatform (KMP) for Android and iOS.",
		tags: ["KMP", "Compose", "iOS", "Android"],
		url: "https://github.com/GuillemRoca/birds",
	},
	{
		title: "github-browser-lab",
		description:
			"GitHub Android client demonstrating modern architecture patterns, Material Design, and best practices.",
		tags: ["Android", "LazyColumn", "Paging3"],
		url: "https://github.com/GuillemRoca/github-browser-lab",
	},
	{
		title: "compose-recompositions",
		description:
			"Educational samples explaining how Jetpack Compose recompositions work and how to optimize them.",
		tags: ["Compose", "Performance", "Education"],
		url: "https://github.com/GuillemRoca/compose-recompositions",
	},
	{
		title: "AM2R-cat",
		description:
			"Localization project translating 'Another Metroid 2 Remake' (AM2R) into Catalan.",
		tags: ["Translation", "Game Mod", "Catalan"],
		url: "https://github.com/GuillemRoca/AM2R-cat",
	},
];
---

<Layout title="Projects | Guillem Roca">
	<div class="page-header">
		<h1>All Projects</h1>
		<p>
			A collection of my open source work, experiments, and contributions.
		</p>
	</div>

	<div class="projects-grid">
		{
			projects.map((project) => (
				<ProjectCard
					title={project.title}
					description={project.description}
					tags={project.tags}
					url={project.url}
				/>
			))
		}
	</div>
</Layout>

<style>
	.page-header {
		padding: 4rem 0 3rem 0;
		text-align: center;
	}

	h1 {
		font-size: 3rem;
		font-weight: 800;
		margin-bottom: 1rem;
	}

	p {
		font-size: 1.2rem;
		opacity: 0.7;
		max-width: 600px;
		margin: 0 auto;
		line-height: 1.6;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 2rem;
		margin-bottom: 5rem;
	}
</style>
